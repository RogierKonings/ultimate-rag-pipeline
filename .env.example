# =============================================================================
# PostgreSQL Configuration
# =============================================================================

# Database credentials
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragpipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application database URL (for services)
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragpipeline

# Sync database URL (for Alembic migrations)
DATABASE_URL_SYNC=postgresql://raguser:ragpass@localhost:5432/ragpipeline

# =============================================================================
# OpenSearch Configuration
# =============================================================================

# OpenSearch connection URL
OPENSEARCH_URL=http://localhost:9200

# Default index name for documents
OPENSEARCH_INDEX=documents

# OpenSearch Security Configuration (for production)
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_USERNAME=rag_user
OPENSEARCH_PASSWORD=rag-user-password-change-me
OPENSEARCH_CA_CERT=/tls/ca.crt

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ragredis

# Default cache TTL in seconds (1 hour)
REDIS_DEFAULT_TTL=3600

# Redis database numbers (for separation)
# 0 = Celery broker, 1 = Celery results, 2 = App caches, 3 = Sessions, 4 = Locks
REDIS_DB=2

# Redis Sentinel Configuration (for HA in production)
REDIS_USE_SENTINEL=false
REDIS_SENTINEL_HOSTS=redis-sentinel.rag-pipeline.svc.cluster.local:26379
REDIS_SENTINEL_MASTER=mymaster

# Redis TLS Configuration (for production)
REDIS_TLS_ENABLED=false
REDIS_TLS_CA_CERT=/tls/ca.crt
REDIS_TLS_CERT=/tls/tls.crt
REDIS_TLS_KEY=/tls/tls.key

# =============================================================================
# MinIO (S3-compatible Object Storage) Configuration
# =============================================================================

# MinIO server endpoint
MINIO_ENDPOINT=localhost:9000

# Root credentials (used for Docker Compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Application credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Default bucket for document storage
MINIO_DEFAULT_BUCKET=documents

# S3-compatible bucket names
S3_BUCKET_RAW=raw-documents
S3_BUCKET_PROCESSED=processed-chunks
S3_BUCKET_BACKUPS=backups
S3_BUCKET_TEMP=temp-uploads

# Use HTTPS for MinIO connection (set to true in production)
MINIO_SECURE=false

# =============================================================================
# Qdrant Vector Database Configuration
# =============================================================================

# Qdrant connection URL
QDRANT_URL=http://localhost:6333

# Default collection name
QDRANT_COLLECTION=documents

# =============================================================================
# Embedding Service Configuration
# =============================================================================

# Embedding service endpoint
EMBEDDING_SERVICE_URL=http://localhost:8080

# Model to use for embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Maximum batch size for embedding requests
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# LLM Service Configuration
# =============================================================================

# LLM gateway endpoint (Ollama for local dev, vLLM for production)
LLM_SERVICE_URL=http://localhost:8004

# Default model for generation
# Recommended models for Apple Silicon (M-series Max with 32-64GB):
#   - llama3.1:8b        - General purpose, fast (~30 tok/s)
#   - qwen2.5:7b         - Good reasoning, multilingual
#   - qwen2.5:14b        - Better quality, still fast
#   - mistral:7b         - Fast inference, good quality
#   - codellama:13b      - Code-focused tasks
#   - deepseek-coder:6.7b - Coding assistant
# For 8GB Macs, use smaller models: qwen2.5:3b, phi3:mini
LLM_MODEL=llama3.1:8b

# =============================================================================
# Reranker Service Configuration
# =============================================================================

# Reranker service endpoint
RERANKER_SERVICE_URL=http://localhost:8081

# Reranker model
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# =============================================================================
# Application Service URLs (for inter-service communication)
# =============================================================================

# Service endpoints
INGESTION_SERVICE_URL=http://localhost:8001
RETRIEVAL_SERVICE_URL=http://localhost:8002
ORCHESTRATOR_SERVICE_URL=http://localhost:8003

# =============================================================================
# Celery Configuration
# =============================================================================

# Celery broker URL
CELERY_BROKER_URL=redis://:ragredis@localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://:ragredis@localhost:6379/1

# =============================================================================
# Observability Configuration
# =============================================================================

# OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name for tracing
OTEL_SERVICE_NAME=rag-pipeline

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Security Configuration
# =============================================================================

# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-change-in-production

# API key for external integrations
API_KEY=your-api-key-change-in-production

# =============================================================================
# Development Configuration
# =============================================================================

# Enable debug mode (never true in production)
DEBUG=true

# Hot reload for FastAPI services
RELOAD=true

# =============================================================================
# Timeout Configuration (all values in milliseconds)
# =============================================================================

# Retrieval Service
RETRIEVAL_EMBEDDING_TIMEOUT_MS=5000
RETRIEVAL_EMBEDDING_RETRIES=2
RETRIEVAL_QDRANT_TIMEOUT_MS=3000
RETRIEVAL_QDRANT_RETRIES=1
RETRIEVAL_OPENSEARCH_TIMEOUT_MS=3000
RETRIEVAL_OPENSEARCH_RETRIES=1
RETRIEVAL_RERANKER_TIMEOUT_MS=8000
RETRIEVAL_RERANKER_RETRIES=1
RETRIEVAL_TOTAL_TIMEOUT_MS=15000

# Orchestrator Service
ORCHESTRATOR_RETRIEVAL_TIMEOUT_MS=20000
ORCHESTRATOR_RETRIEVAL_RETRIES=1
ORCHESTRATOR_LLM_TIMEOUT_MS=25000
ORCHESTRATOR_TOTAL_TIMEOUT_MS=30000

# Ingestion Service
INGESTION_PARSING_TIMEOUT_MS=60000
INGESTION_EMBEDDING_TIMEOUT_MS=30000
INGESTION_EMBEDDING_RETRIES=2
INGESTION_QDRANT_UPSERT_TIMEOUT_MS=10000
INGESTION_QDRANT_UPSERT_RETRIES=2
INGESTION_OPENSEARCH_INDEX_TIMEOUT_MS=10000
INGESTION_OPENSEARCH_INDEX_RETRIES=2
INGESTION_DOCUMENT_TIMEOUT_MS=300000
INGESTION_DOCUMENT_RETRIES=3

# Infrastructure
REDIS_OPERATION_TIMEOUT_MS=1000
REDIS_OPERATION_RETRIES=1
POSTGRES_QUERY_TIMEOUT_MS=5000
POSTGRES_QUERY_RETRIES=1
HTTP_CONNECTION_TIMEOUT_MS=5000
