# =============================================================================
# Frontend Environment Configuration
# =============================================================================
# This file shows all required environment variables for the frontend.
#
# For local development: Run 'make env-frontend' from project root after
# running 'make env-local' to generate this file from root configuration.
#
# For Docker: The docker-compose.yml uses env_file directives to load
# configuration from .env.base and .env.docker automatically.
# =============================================================================

# Public environment variables (exposed to client-side JavaScript)
# These are prefixed with PUBLIC_ and can be accessed in SvelteKit via
# import.meta.env or $env/static/public
PUBLIC_ORCHESTRATOR_URL=http://localhost:8003
PUBLIC_INGESTION_URL=http://localhost:8001
PUBLIC_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001

# Private environment variables (server-side only)
# These are used by server routes/API proxies and are NOT exposed to the browser

# MinIO/S3 Configuration (for file uploads)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=rag-documents

# Backend Service URLs (for server-side proxying)
INGESTION_SERVICE_URL=http://localhost:8001
ORCHESTRATOR_SERVICE_URL=http://localhost:8003
RETRIEVAL_URL=http://localhost:8002

# Demo tenant for testing
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
