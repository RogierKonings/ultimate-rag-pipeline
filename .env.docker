# =============================================================================
# Docker Compose Environment Configuration
# =============================================================================
# This file contains Docker service name URLs for docker-compose.
# Combined with .env.base to create .env via: make env-docker
# =============================================================================

# Deployment environment marker
DEPLOY_ENV=docker

# =============================================================================
# Database URLs (Docker service names)
# =============================================================================
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@postgres:5432/ragpipeline
DATABASE_URL_SYNC=postgresql://raguser:ragpass@postgres:5432/ragpipeline
POSTGRES_SSL_MODE=disable

# =============================================================================
# Redis URLs (Docker service names)
# =============================================================================
REDIS_HOST=redis
REDIS_URL=redis://:ragredis@redis:6379/2
CELERY_BROKER_URL=redis://:ragredis@redis:6379/0
CELERY_RESULT_BACKEND=redis://:ragredis@redis:6379/1

# =============================================================================
# Vector Store & Search URLs (Docker service names)
# =============================================================================
QDRANT_URL=http://qdrant:6333
OPENSEARCH_URL=http://opensearch:9200

# =============================================================================
# Object Storage URLs (Docker service names)
# =============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_URL=http://minio:9000

# =============================================================================
# ML Service URLs (Docker service names)
# =============================================================================
EMBEDDING_SERVICE_URL=http://embedding-service:8080
RERANKER_SERVICE_URL=http://reranker-service:8081

# NOTE: For GPU acceleration on Apple Silicon, Ollama runs natively on host
# Docker containers access it via host.docker.internal
LLM_SERVICE_URL=http://host.docker.internal:11434
LLM_GATEWAY_URL=http://host.docker.internal:11434

# =============================================================================
# Application Service URLs (Docker service names)
# =============================================================================
INGESTION_SERVICE_URL=http://ingestion-service:8001
RETRIEVAL_SERVICE_URL=http://retrieval-service:8002
ORCHESTRATOR_SERVICE_URL=http://orchestrator-service:8003

# =============================================================================
# Observability URLs (Docker service names)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
JAEGER_URL=http://jaeger:16686
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
LOKI_URL=http://loki:3100
PHOENIX_URL=http://phoenix:6006

# =============================================================================
# Security URLs (Docker service names)
# =============================================================================
VAULT_ADDR=http://vault:8200

# =============================================================================
# Service-specific prefixed variables (for backward compatibility)
# =============================================================================

# Ingestion service
INGESTION_DATABASE_URL=postgresql://raguser:ragpass@postgres:5432/ragpipeline
INGESTION_QDRANT_URL=http://qdrant:6333
INGESTION_OPENSEARCH_URL=http://opensearch:9200
INGESTION_REDIS_URL=redis://:ragredis@redis:6379
INGESTION_MINIO_URL=http://minio:9000
INGESTION_MINIO_ACCESS_KEY=${MINIO_ROOT_USER:-minioadmin}
INGESTION_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD:-minioadmin123}
INGESTION_MINIO_BUCKET=rag-documents
INGESTION_LLM_GATEWAY_URL=http://host.docker.internal:11434
INGESTION_DEBUG=true

# Retrieval service
RETRIEVAL_QDRANT_URL=http://qdrant:6333
RETRIEVAL_OPENSEARCH_URL=http://opensearch:9200
RETRIEVAL_REDIS_URL=redis://:ragredis@redis:6379
RETRIEVAL_LLM_GATEWAY_URL=http://host.docker.internal:11434
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_LOG_LEVEL=DEBUG

# Orchestrator service
ORCHESTRATOR_RETRIEVAL_URL=http://retrieval-service:8002
ORCHESTRATOR_LLM_GATEWAY_URL=http://host.docker.internal:11434
ORCHESTRATOR_REDIS_URL=redis://:ragredis@redis:6379
ORCHESTRATOR_DATABASE_URL=postgresql+asyncpg://raguser:ragpass@postgres:5432/ragpipeline

# Frontend
PUBLIC_ORCHESTRATOR_URL=http://orchestrator-service:8003
PUBLIC_INGESTION_URL=http://ingestion-service:8001
PUBLIC_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
