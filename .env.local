# =============================================================================
# Local Development Environment Configuration
# =============================================================================
# This file contains localhost URLs for local development.
# Combined with .env.base to create .env via: make env-local
# =============================================================================

# Deployment environment marker
DEPLOY_ENV=local

# =============================================================================
# Database URLs (localhost)
# =============================================================================
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragpipeline
DATABASE_URL_SYNC=postgresql://raguser:ragpass@localhost:5432/ragpipeline

# =============================================================================
# Redis URLs (localhost)
# =============================================================================
REDIS_HOST=localhost
REDIS_URL=redis://:ragredis@localhost:6379/2
CELERY_BROKER_URL=redis://:ragredis@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:ragredis@localhost:6379/1

# =============================================================================
# Vector Store & Search URLs (localhost)
# =============================================================================
QDRANT_URL=http://localhost:6334
OPENSEARCH_URL=http://localhost:9200

# =============================================================================
# Object Storage URLs (localhost)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_URL=http://localhost:9000

# =============================================================================
# ML Service URLs (localhost)
# =============================================================================
EMBEDDING_SERVICE_URL=http://localhost:8080
RERANKER_SERVICE_URL=http://localhost:8081
LLM_SERVICE_URL=http://localhost:8004
LLM_GATEWAY_URL=http://localhost:8004

# =============================================================================
# Application Service URLs (localhost)
# =============================================================================
INGESTION_SERVICE_URL=http://localhost:8001
RETRIEVAL_SERVICE_URL=http://localhost:8002
ORCHESTRATOR_SERVICE_URL=http://localhost:8003

# =============================================================================
# Observability URLs (localhost)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_URL=http://localhost:16686
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
LOKI_URL=http://localhost:3100
PHOENIX_URL=http://localhost:6006

# =============================================================================
# Security URLs (localhost)
# =============================================================================
VAULT_ADDR=http://localhost:8200
