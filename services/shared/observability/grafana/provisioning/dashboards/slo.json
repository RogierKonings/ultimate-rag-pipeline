{
  "uid": "rag-slo",
  "title": "RAG SLO Dashboard",
  "description": "Service Level Objectives tracking with error budgets and burn rates",
  "tags": ["rag-pipeline", "slo"],
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Query Availability SLO (99.9%)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(rag_query_total{status=\"success\"}[30d])) / sum(rate(rag_query_total[30d]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.999, "color": "yellow"},
              {"value": 0.9995, "color": "green"}
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "title": "Query Latency SLO (99% < 2s)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(rag_query_duration_seconds_bucket{le=\"2\"}[30d])) / sum(rate(rag_query_duration_seconds_count[30d]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.95,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.99, "color": "yellow"},
              {"value": 0.995, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "LLM TTFT SLO (95% < 1s)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(rag_llm_ttft_seconds_bucket{le=\"1\"}[7d])) / sum(rate(rag_llm_ttft_seconds_count[7d]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.95, "color": "yellow"},
              {"value": 0.97, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Retrieval Latency SLO (99% < 500ms)",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(rag_retrieval_duration_seconds_bucket{le=\"0.5\"}[30d])) / sum(rate(rag_retrieval_duration_seconds_count[30d]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.95,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.99, "color": "yellow"},
              {"value": 0.995, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Availability Error Budget Remaining",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 6},
      "description": "Error budget = 0.1% for 30 days",
      "targets": [
        {
          "expr": "1 - ((1 - (sum(rate(rag_query_total{status=\"success\"}[30d])) / sum(rate(rag_query_total[30d])))) / 0.001)",
          "legendFormat": "Availability",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.25, "color": "orange"},
              {"value": 0.5, "color": "yellow"},
              {"value": 0.75, "color": "green"}
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 6,
      "title": "Latency Error Budget Remaining",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 6},
      "description": "Error budget = 1% for 30 days",
      "targets": [
        {
          "expr": "1 - ((1 - (sum(rate(rag_query_duration_seconds_bucket{le=\"2\"}[30d])) / sum(rate(rag_query_duration_seconds_count[30d])))) / 0.01)",
          "legendFormat": "Latency",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.25, "color": "orange"},
              {"value": 0.5, "color": "yellow"},
              {"value": 0.75, "color": "green"}
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 7,
      "title": "TTFT Error Budget Remaining",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 6},
      "description": "Error budget = 5% for 7 days",
      "targets": [
        {
          "expr": "1 - ((1 - (sum(rate(rag_llm_ttft_seconds_bucket{le=\"1\"}[7d])) / sum(rate(rag_llm_ttft_seconds_count[7d])))) / 0.05)",
          "legendFormat": "TTFT",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.25, "color": "orange"},
              {"value": 0.5, "color": "yellow"},
              {"value": 0.75, "color": "green"}
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 8,
      "title": "Retrieval Error Budget Remaining",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 6},
      "description": "Error budget = 1% for 30 days",
      "targets": [
        {
          "expr": "1 - ((1 - (sum(rate(rag_retrieval_duration_seconds_bucket{le=\"0.5\"}[30d])) / sum(rate(rag_retrieval_duration_seconds_count[30d])))) / 0.01)",
          "legendFormat": "Retrieval",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.25, "color": "orange"},
              {"value": 0.5, "color": "yellow"},
              {"value": 0.75, "color": "green"}
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 9,
      "title": "SLO Compliance Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "sum(rate(rag_query_total{status=\"success\"}[1h])) / sum(rate(rag_query_total[1h]))",
          "legendFormat": "Availability (target: 99.9%)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rag_query_duration_seconds_bucket{le=\"2\"}[1h])) / sum(rate(rag_query_duration_seconds_count[1h]))",
          "legendFormat": "Latency (target: 99%)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(rag_llm_ttft_seconds_bucket{le=\"1\"}[1h])) / sum(rate(rag_llm_ttft_seconds_count[1h]))",
          "legendFormat": "TTFT (target: 95%)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1,
          "custom": {"fillOpacity": 10}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 10,
      "title": "Error Budget Burn Rate (1h window)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "description": "Burn rate > 1 means consuming budget faster than allowed",
      "targets": [
        {
          "expr": "(1 - (sum(rate(rag_query_total{status=\"success\"}[1h])) / sum(rate(rag_query_total[1h])))) / 0.001 * (30*24)",
          "legendFormat": "Availability Burn Rate",
          "refId": "A"
        },
        {
          "expr": "(1 - (sum(rate(rag_query_duration_seconds_bucket{le=\"2\"}[1h])) / sum(rate(rag_query_duration_seconds_count[1h])))) / 0.01 * (30*24)",
          "legendFormat": "Latency Burn Rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"fillOpacity": 10},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 6, "color": "orange"},
              {"value": 14.4, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 11,
      "title": "Multi-Window Burn Rate Alerts",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "description": "Shows current burn rates across different time windows",
      "targets": [
        {
          "expr": "(1 - (sum(rate(rag_query_total{status=\"success\"}[5m])) / sum(rate(rag_query_total[5m])))) / 0.001 * (30*24)",
          "legendFormat": "Availability 5m",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "(1 - (sum(rate(rag_query_total{status=\"success\"}[1h])) / sum(rate(rag_query_total[1h])))) / 0.001 * (30*24)",
          "legendFormat": "Availability 1h",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "(1 - (sum(rate(rag_query_total{status=\"success\"}[6h])) / sum(rate(rag_query_total[6h])))) / 0.001 * (30*24)",
          "legendFormat": "Availability 6h",
          "refId": "C",
          "instant": true
        },
        {
          "expr": "(1 - (sum(rate(rag_query_duration_seconds_bucket{le=\"2\"}[5m])) / sum(rate(rag_query_duration_seconds_count[5m])))) / 0.01 * (30*24)",
          "legendFormat": "Latency 5m",
          "refId": "D",
          "instant": true
        },
        {
          "expr": "(1 - (sum(rate(rag_query_duration_seconds_bucket{le=\"2\"}[1h])) / sum(rate(rag_query_duration_seconds_count[1h])))) / 0.01 * (30*24)",
          "legendFormat": "Latency 1h",
          "refId": "E",
          "instant": true
        },
        {
          "expr": "(1 - (sum(rate(rag_query_duration_seconds_bucket{le=\"2\"}[6h])) / sum(rate(rag_query_duration_seconds_count[6h])))) / 0.01 * (30*24)",
          "legendFormat": "Latency 6h",
          "refId": "F",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 6, "color": "orange"},
              {"value": 14.4, "color": "red"}
            ]
          },
          "custom": {
            "displayMode": "color-background"
          }
        }
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "merge"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
