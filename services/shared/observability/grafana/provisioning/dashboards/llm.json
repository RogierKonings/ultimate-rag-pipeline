{
  "uid": "rag-llm",
  "title": "RAG LLM Service",
  "description": "Metrics for LLM serving including latency, throughput, tokens, and costs",
  "tags": ["rag-pipeline", "llm"],
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(rag_llm_duration_seconds_bucket, model)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(rag_llm_requests_total, provider)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "LLM Request Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(rag_llm_requests_total{model=~\"$model\", provider=~\"$provider\"}[5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        }
      }
    },
    {
      "id": 2,
      "title": "P95 LLM Latency",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_llm_duration_seconds_bucket{model=~\"$model\", provider=~\"$provider\"}[5m])) by (le))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 2, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "P50 TTFT",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_llm_ttft_seconds_bucket{model=~\"$model\", provider=~\"$provider\"}[5m])) by (le))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.5, "color": "yellow"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Tokens/sec Throughput",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(rag_llm_tokens_total{model=~\"$model\", provider=~\"$provider\", type=\"output\"}[5m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(rag_llm_requests_total{model=~\"$model\", provider=~\"$provider\", status=\"error\"}[5m])) / sum(rate(rag_llm_requests_total{model=~\"$model\", provider=~\"$provider\"}[5m])) * 100",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Est. Cost (24h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "description": "Estimated cost based on input/output token pricing",
      "targets": [
        {
          "expr": "(sum(increase(rag_llm_tokens_total{type=\"input\"}[24h])) * 0.000003) + (sum(increase(rag_llm_tokens_total{type=\"output\"}[24h])) * 0.000015)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      }
    },
    {
      "id": 7,
      "title": "LLM Latency by Model",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_llm_duration_seconds_bucket{provider=~\"$provider\"}[5m])) by (le, model))",
          "legendFormat": "{{model}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"fillOpacity": 10, "lineWidth": 1}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 8,
      "title": "TTFT by Model",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_llm_ttft_seconds_bucket{provider=~\"$provider\"}[5m])) by (le, model))",
          "legendFormat": "{{model}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_llm_ttft_seconds_bucket{provider=~\"$provider\"}[5m])) by (le, model))",
          "legendFormat": "{{model}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"fillOpacity": 10}
        }
      }
    },
    {
      "id": 9,
      "title": "Token Usage Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "sum(rate(rag_llm_tokens_total{model=~\"$model\", provider=~\"$provider\", type=\"input\"}[5m]))",
          "legendFormat": "Input Tokens/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rag_llm_tokens_total{model=~\"$model\", provider=~\"$provider\", type=\"output\"}[5m]))",
          "legendFormat": "Output Tokens/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"fillOpacity": 30}
        }
      }
    },
    {
      "id": 10,
      "title": "Error Rate by Provider",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {
          "expr": "sum by (provider) (rate(rag_llm_requests_total{model=~\"$model\", status=\"error\"}[5m])) / sum by (provider) (rate(rag_llm_requests_total{model=~\"$model\"}[5m])) * 100",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {"fillOpacity": 10},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Prompt Token Distribution",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "sum by (le) (rate(rag_llm_prompt_tokens_bucket{model=~\"$model\"}[5m]))",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {"scheme": "Turbo"},
        "yAxis": {"unit": "short"}
      }
    },
    {
      "id": 12,
      "title": "Request Rate by Model",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {
          "expr": "sum by (model) (rate(rag_llm_requests_total{provider=~\"$provider\"}[5m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"fillOpacity": 30}
        }
      }
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
